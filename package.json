{
  "name": "locally",
  "productName": "Brief",
  "version": "2.1.3-beta",
  "description": "Brief — Private local desktop AI agent. Runs exclusively on your computer.",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "node scripts/launch.js",
    "selftest": "node scripts/launch.js --selftest",
    "check": "node scripts/check.js",
    "build:win": "node scripts/build-win.js",
    "build:linux": "node scripts/build-linux.js",
    "build:installer": "node scripts/build-installer.js",
    "site": "node download-site/server.js",
    "postinstall": "node -e \"if (require('fs').existsSync('node_modules/electron/install.js')) require('./node_modules/electron/install.js');\""
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "rcedit": "^5.0.2"
  }
}
